# Seed2Store runs with ZERO configuration: a local JSON database seeded with demo
# lots, local photo storage, and off-chain (content-hashed) certificates.
# Everything below is optional. Copy to .env.local and fill in what you need.

# --- Blockchain (on-chain certificates, escrowed auctions, direct purchase) --------
# `npm run deploy:local` writes these three for you after `npm run chain`.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_NFT_CONTRACT=
# NEXT_PUBLIC_CHAIN_NAME=Hardhat Local
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
# Fixed conversion used to price lots on-chain (USD per 1 ETH).
NEXT_PUBLIC_ETH_USD=2500
# Server-side RPC override (e.g. a private endpoint); defaults to NEXT_PUBLIC_RPC_URL.
# RPC_URL=

# First block the explorer scans (the deploy script writes this)
# NEXT_PUBLIC_DEPLOY_BLOCK=0

# Deploying to Sepolia / Ganache (testnet-only key, fund it from a faucet)
# DEPLOYER_PRIVATE_KEY=0x...
# ETHERSCAN_API_KEY=            # optional: also verify on Etherscan (Sourcify needs no key)
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# GANACHE_RPC_URL=http://127.0.0.1:7545

# --- Database: MongoDB ---------------------------------------------------------------
# Set this and every record, uploaded photo (GridFS) and setting is stored in MongoDB.
# Local server or Atlas both work. Collections and indexes are created on first start,
# The database starts empty. DEMO_SEED=true fills an empty one with a sample market.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=seed2store
# DEMO_SEED=false

# --- IPFS via Pinata (photos + token metadata; overrides GridFS for photos) ------------
# PINATA_JWT=
# PINATA_GATEWAY=https://gateway.pinata.cloud

# --- Sessions -------------------------------------------------------------------------
# Optional. Without it a random secret is generated once and stored in the database.
# AUTH_SECRET=
